# Matriz: filas = días, columnas
dias = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"]
horas = ["6-8", "8-10", "10-12", "12-14", "14-16", "16-18"]

ocupacion = [
    [3, 7, 4, 6, 2, 5],  # Lunes
    [1, 4, 3, 8, 4, 2],  # Martes
    [2, 6, 4, 5, 3, 4],  # Miércoles
    [4, 3, 2, 7, 1, 3],  # Jueves
    [3, 4, 1, 6, 2, 4]   # Viernes
]

#1 Buscar la mayor congestión
mayor = -1
diaMayor = 0
franjaMayor = 0

for i in range(5):
    for j in range(6):
        if ocupacion[i][j] > mayor:
            mayor = ocupacion[i][j]
            diaMayor = i
            franjaMayor = j

print("Mayor congestión:")
print(f"{mayor} personas, {dias[diaMayor]} de {horas[franjaMayor]}")

#2 Buscar el día con mayor ocupación total
mayorTotal = -1
diaMayorTotal = 0

for i in range(5):
    total = 0

    for j in range(6):
        total += ocupacion[i][j]

    if total > mayorTotal:
        mayorTotal = total
        diaMayorTotal = i

print("\nDía con mayor ocupación:")
print(f"{dias[diaMayorTotal]} con {mayorTotal} personas")

#3 Buscar franjas siempre por debajo de 5 personas
print("\nFranjas por debajo de 5 personas:")

for j in range(6):
    siempreMenorQue5 = True

    for i in range(5):
        if ocupacion[i][j] >= 5:
            siempreMenorQue5 = False

    if siempreMenorQue5:
        print(horas[j])