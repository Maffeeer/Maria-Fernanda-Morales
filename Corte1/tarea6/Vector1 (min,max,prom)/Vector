#include <iostream>
#include <vector>
using namespace std;

int main() {
    // Vector con los números
    vector<int> numeros = {23, 45, 12, 67, 34, 89, 5, 56};

    int maximo = numeros[0];
    int minimo = numeros[0];
    int suma = 0;

    for (int i = 0; i < numeros.size(); i++) {
        suma += numeros[i];

        if (numeros[i] > maximo) {
            maximo = numeros[i];
        }

        if (numeros[i] < minimo) {
            minimo = numeros[i];
        }
    }

    double promedio =   suma / numeros.size();

    cout << "Vector: ";
    for (int i = 0; i < numeros.size(); i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    cout << "Maximo: " << maximo << endl;
    cout << "Minimo: " << minimo << endl;
    cout << "Promedio: " << promedio << endl;

    return 0;
}