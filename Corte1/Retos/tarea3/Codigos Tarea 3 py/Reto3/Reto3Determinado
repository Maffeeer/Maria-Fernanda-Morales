import random

n = int(input("¿Cuántas rondas desea jugar? "))

for contador in range(1, n + 1):
    eleccion = input(f"Ronda {contador} - Elija Cara (C) o Sello (S): ").upper()

    numAleatorio = random.randint(0, 1)  # genera 0 o 1

    if numAleatorio == 0:
        resultado = "C"
    else:
        resultado = "S"

    print("La moneda cayó en:", resultado)

    if eleccion == resultado:
        print("Ganaste")
    else:
        print("Perdiste.")