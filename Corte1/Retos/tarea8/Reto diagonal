matriz = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

n = len(matriz)

sumaPrincipal = 0
sumaSecundaria = 0

for i in range(n):
    for j in range(n):
        if i == j:
            sumaPrincipal += matriz[i][j]

        if j == n - 1 - i:
            sumaSecundaria += matriz[i][j]

print("Suma diagonal principal:", sumaPrincipal)
print("Suma diagonal secundaria:", sumaSecundaria)

if sumaPrincipal == sumaSecundaria:
    print("Las diagonales son iguales")
else:
    print("Las diagonales son diferentes")