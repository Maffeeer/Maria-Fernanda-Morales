#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    int numRondas, numAleatorio;
    char eleccion, resultado;

    srand(time(0));

    cout << "¿Cuántas rondas desea jugar? ";
    cin >> numRondas;

    for (int contador = 1; contador <= numRondas; contador++) {
        cout << "Ronda " << contador << " - Elija Cara (C) o Sello (S): ";
        cin >> eleccion;

        numAleatorio = rand() % 2; // genera 0 o 1

        if (numAleatorio == 0) {
            resultado = 'C';
        } else {
            resultado = 'S';
        }

        cout << "La moneda cayó en: " << resultado << endl;

        if (eleccion == resultado) {
            cout << "Ganaste." << endl;
        } else {
            cout << "Perdiste." << endl;
        }
    }

    return 0;
}