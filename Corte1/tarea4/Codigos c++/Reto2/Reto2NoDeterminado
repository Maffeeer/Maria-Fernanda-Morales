#include <iostream>
using namespace std;

int main() {
    float pesoBebe, mesesBebe, dosisVacuna;
    char respuesta;

    do {
        cout << "Ingrese el peso del bebé (kg): ";
        cin >> pesoBebe;

        cout << "Ingrese la edad del bebé (meses): ";
        cin >> mesesBebe;

        dosisVacuna = ((pesoBebe + 10) / (mesesBebe * 10)) * 8;

        cout << "La dosis de la vacuna es: " << dosisVacuna << endl;

        cout << "¿Desea calcular la dosis de otro bebé? (Si = 1/No = 0): ";
        cin >> respuesta;

    } while (respuesta == '1');

    return 0;
}