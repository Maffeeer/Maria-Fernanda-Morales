nivel = 0
def factorial (n):
    global nivel
    print("| " * nivel + f"factorial({n}) entra")
    nivel += 1

    r = 1 if n <= 1 else n * factorial(n - 1)
    nivel -= 1
    print("| " * nivel + f"factorial ({n}) devuelve {r}")
    return r

def fibonacci (n):
    if n <= 1:
        return n
    return fibonacci (n - 1) + fibonacci (n - 2)
    print()

factorial (4)
print(fibonacci(10))
