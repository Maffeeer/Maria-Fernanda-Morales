import time
from typing import List, Optional


# Suma recursiva de una lista

def sumaLista(lista: List[int], indice: int = 0) -> int:
    if indice >= len(lista):
        return 0

    return lista[indice] + sumaLista(lista, indice + 1)


def sumaListaV2(lista: List[int]) -> int:
    """Version que divide la lista en head y tail."""
    if len(lista) == 0:
        return 0

    return lista[0] + sumaListaV2(lista[1:])


# Potencia recursiva: simple vs optimizada

def potenciaSimple(a: int, b: int, llamadas: int = 0) -> tuple[int, int]:
    llamadas += 1

    if b == 0:
        return 1, llamadas

    resultado, llamadas = potenciaSimple(a, b - 1, llamadas)
    return a * resultado, llamadas


def potenciaOptimizada(a: int, b: int, llamadas: int = 0) -> tuple[int, int]:
    llamadas += 1

    if b == 0:
        return 1, llamadas

    if b % 2 == 0:
        resultado, llamadas = potenciaOptimizada(a, b // 2, llamadas)
        return resultado * resultado, llamadas

    else:
        resultado, llamadas = potenciaOptimizada(a, b - 1, llamadas)
        return a * resultado, llamadas


# Invertir cadena recursiva

def invertirCadena(s: str) -> str:
    if len(s) <= 1:
        return s

    return invertirCadena(s[1:]) + s[0]


def invertirCadenaV2(s: str, i: int = None) -> str:
    """Version usando indice en lugar de slicing."""
    if i is None:
        i = len(s) - 1

    if i < 0:
        return ""

    return s[i] + invertirCadenaV2(s, i - 1)


# Lista enlazada

class Nodo:
    """Nodo de una lista enlazada."""
    def __init__(self, valor, siguiente=None):
        self.valor = valor
        self.siguiente = siguiente

    def __repr__(self):
        return f"Nodo({self.valor})"


class ListaEnlazada:
    """Lista enlazada simple."""
    def __init__(self):
        self.cabeza = None

    def agregar(self, valor):
        """Agrega un valor al inicio."""
        self.cabeza = Nodo(valor, self.cabeza)

    def agregarAlFinal(self, valor):
        """Agrega un valor al final."""
        if not self.cabeza:
            self.cabeza = Nodo(valor)
        else:
            self._agregarAlFinalRec(self.cabeza, valor)

    def _agregarAlFinalRec(self, nodo, valor):
        """Recursivo: recorre hasta el final."""
        if nodo.siguiente is None:
            nodo.siguiente = Nodo(valor)
        else:
            self._agregarAlFinalRec(nodo.siguiente, valor)

    def imprimirNormal(self, nodo="__INIT__"):
        if nodo == "__INIT__":
            nodo = self.cabeza

        if nodo is None:
            return

        print(f"{nodo.valor}", end=" → ")

        self.imprimirNormal(nodo.siguiente)

    def imprimirInverso(self, nodo="__INIT__"):
        if nodo == "__INIT__":
            nodo = self.cabeza

        if nodo is None:
            return

        self.imprimirInverso(nodo.siguiente)

        print(f"{nodo.valor}", end=" → ")

    def recorridoCompleto(self):
        print("\n Lista", end="")
        nodo = self.cabeza
        while nodo:
            print(f"{nodo.valor}", end=" → ")
            nodo = nodo.siguiente
        print("None")

        print("\n orden normal:", end=" ")
        self.imprimirNormal()
        print("None")

        print("\n orden inverso:", end=" ")
        self.imprimirInverso()
        print("None")


# Pruebas

def pruebaUno():
    print("Suma de lista recursiva")

    listasPrueba = [
        [1, 2, 3, 4, 5],
        [10, 20, 30],
        [100],
        [],
        [5, -3, 2, -1, 4],
    ]

    for lista in listasPrueba:
        resultado = sumaLista(lista)
        resultadoV2 = sumaListaV2(lista)
        sumaPython = sum(lista)

        print(f"Lista: {lista}")
        print(f"  sumaLista():    {resultado}")
        print(f"  sumaListaV2():  {resultadoV2}")
        print(f"  sum() Python:   {sumaPython}")
        print(f"  Correctos: {resultado == sumaPython}")
        print()


def pruebaDos():
    print("Potencia recursiva: simple vs optimizada")

    casos = [
        (2, 10),
        (3, 8),
        (2, 20),
        (5, 6),
        (2, 30),
    ]

    print(f"{'a':<5} {'b':<5} {'Resultado':<15} {'Simple':<15} {'Optimizada':<18} {'Mejora':<10}")
    print("-" * 75)

    for a, b in casos:
        tiempoIniS = time.perf_counter()
        resultadoS, llamadasS = potenciaSimple(a, b)
        tiempoS = time.perf_counter() - tiempoIniS

        tiempoIniO = time.perf_counter()
        resultadoO, llamadasO = potenciaOptimizada(a, b)
        tiempoO = time.perf_counter() - tiempoIniO

        correcto = resultadoS == resultadoO == a**b
        factor = llamadasS / llamadasO if llamadasO > 0 else 1

        print(f"{a:<5} {b:<5} {a}^{b}={resultadoS:<10} {llamadasS:>6} llamadas  {llamadasO:>6} llamadas  {factor:>7.1f}x")

    print("Analisis")
    print(f"  Simple:      O(b) llamadas")
    print(f"  Optimizada:  O(log b) llamadas")
    print(f"  Ejemplo: 2^30")
    print(f"  Simple:     30 llamadas")
    print(f"  Optimizada: 5 llamadas (log 30)")
    print()


def pruebaTres():
    print("Invertir cadena recursiva")

    cadenas = [
        "Hola",
        "Recursion",
        "Python",
        "A",
