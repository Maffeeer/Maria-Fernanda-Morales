def mostrarPilaFactorial():
    print("\n Ejecucion \n")

    nivel = [0]

    def factorialConTraza(n):
        print("|  " * nivel[0] + f"factorial({n}) entra")
        nivel[0] += 1

        r = 1 if n <= 1 else n * factorialConTraza(n - 1)

        nivel[0] -= 1
        print("|  " * nivel[0] + f"factorial({n}) devuelve {r}")
        return r

    resultado = factorialConTraza(4)
    print(f"\n Resultado: {resultado}")


